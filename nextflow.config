/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    drugMR Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Multi-omic Mendelian randomisation pipeline for AD drug target discovery
----------------------------------------------------------------------------------------
*/


// work -> temp storage for stuff outside nf workflow thus...
workDir = './tmp/nf-work'

params {
    // container image, pinned by digest so every run uses exactly this build
    // (tag v1.0.0; the digest is immutable, the tag could in principle be moved)
    image_name = 'ghcr.io/guillermocomesanacimadevila/drugmr@sha256:2dec5aebec2c1cae1a96484945f9a694fbe90337bf3588c568184534cf916dee'

    // inputs
    inputs = params.inputs ?: [[
        pheno_id: params.pheno_id,
        pqtl_dataset: params.pqtl_dataset,
        sumstats: params.sumstats,
        n_cases: params.n_cases,
        n_controls: params.n_controls,
        genome_build: params.genome_build,
        target_build: params.target_build,
        snp_col: params.snp_col,
        a1_col: params.a1_col,
        a2_col: params.a2_col,
        beta_col: params.beta_col,
        se_col: params.se_col,
        p_col: params.p_col,
        pos_col: params.pos_col,
        chr_col: params.chr_col,
        af_col: params.af_col,
        ref_bfile: params.containsKey('reference_data') ? params.reference_data.ref_bfile : params.ref_bfile,
        liftover_dir: params.containsKey('reference_data') && params.reference_data.liftover_dir ? params.reference_data.liftover_dir : 'ref/liftover',
        gene_annotation: params.containsKey('reference_data') ? params.reference_data.gene_annotation : null,
        maf: params.maf,
        overwrite: params.overwrite,
        remove_mhc: params.remove_mhc,
        remove_apoe: params.remove_apoe,
        run_smr: params.run_smr,
        bulk_qtl_datasets: params.bulk_qtl_datasets,
        sc_qtl_dataset: params.sc_qtl_dataset,
        info_col: params.info_col,
        info_threshold: params.info_threshold,
        gates: params.gates
    ]]

    // QTL manifest
    manifest_path = 'assets/qtl_manifest.csv'

    // out dirs
    runs_root = 'runs'
    out_dir = 'results'

    // slurm account ID (project CODE)
    slurm_account = null

    // slurm partition (default: 'compute', 3-day limit, general-purpose)
    slurm_partition = 'compute'

    // extra host directory to bind into the container, beyond the pipeline's
    // own tree -> needed when sumstats/QTL paths in your params file live
    container_bind = null

    // run identity (do not override directly -> derived from inputs[0] + git SHA)
    trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    // git state of the pipeline code, read once at launch from the pipeline folder
    // (not the launch directory), so run_id and manifest.json always agree
    git_sha7  = ['git', '-C', "${projectDir}", 'rev-parse', '--short=7', 'HEAD'].execute().text.trim() ?: 'unknown'
    git_dirty = params.git_sha7 == 'unknown' ? 'unknown' : (['git', '-C', "${projectDir}", 'status', '--porcelain', '--untracked-files=no'].execute().text.trim() ? 'true' : 'false')
    run_id = "${params.inputs[0].pheno_id}_${params.inputs[0].pqtl_dataset}_${params.trace_timestamp}_${params.git_sha7}"
    tracedir = "${params.runs_root}/${params.run_id}/pipeline_info"

    // AWS Batch job queue name (pre-provisioned in AWS, required for -profile aws)
    aws_batch_queue = null

    // AWS region for Batch + S3 (default: eu-west-2)
    aws_region = null

    // GCP project ID (required for -profile gcp)
    gcp_project = null

    // GCP location/region for Batch (default: europe-west2)
    gcp_location = null

    // resource params
    max_memory = 128.GB
    max_time = 240.h
    max_cpus = 64
}

// Export PYTHONNOUSERSITE to stop a user's own ~/.local Python packages from
// leaking into (and potentially shadowing) the pipeline's pinned environment
env {
    PYTHONNOUSERSITE = 1
}

// Fail loudly on an unset variable or a failed step mid-pipe, rather than the
// default permissive bash behaviour silently continuing
process.shell = [
    "bash",
    "-C",         // no clobber - don't let output redirection overwrite files
    "-e",         // exit on any non-zero exit code
    "-u",         // treat unset variables as an error
    "-o",
    "pipefail"    // a failed step inside a pipe fails the whole command
]

// Per-process cpu/memory/time defaults -> see conf/base.config for the actual
includeConfig 'conf/base.config'

// apply resource params limits to each process (this changed from the og funct in github)
process.resourceLimits = [
    cpus: params.max_cpus,
    memory: params.max_memory,
    time: params.max_time
]

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profiles for containerisation
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

----------------------------------------------------------------------------------------
*/

profiles {

    local {
        process.executor = 'local'
    }

    test {
        includeConfig 'conf/test.config'
    }

    // for any reviewer / any live talks explaning drugMR's usage
    demo {
        includeConfig 'conf/demo.config'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = params.slurm_partition
        process.clusterOptions = "--account=${params.slurm_account}"
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = params.container_bind ? "--bind ${params.container_bind}" : ''
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    docker {
        docker.enabled = true
        singularity.enabled = false
        apptainer.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = params.container_bind ? "--bind ${params.container_bind}" : ''
        docker.enabled = false
        apptainer.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = params.container_bind ? "--bind ${params.container_bind}" : ''
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    podman {
        podman.enabled         = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }

    shifter {
        shifter.enabled        = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
        podman.enabled         = false
        charliecloud.enabled   = false
    }

    charliecloud {
        charliecloud.enabled   = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
        podman.enabled         = false
        shifter.enabled        = false
    }

    // GCP -> work_dir -> change to GCS bucket loc
    gcp {
        process.executor = 'google-batch'
        docker.enabled = true // e.g. artifact registry
        singularity.enabled = false
        apptainer.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false

        google {
            project = params.gcp_project
            location = params.gcp_location ?: 'europe-west2'
            batch {
                spot = true
            }
        }
    }

    // AWS -> work_dir -> S3 bucket
    aws {
        process.executor = 'awsbatch'
        process.queue = params.aws_batch_queue
        docker.enabled = true
        singularity.enabled = false
        apptainer.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false

        aws {
            region = params.aws_region ?: 'eu-west2'
            batch {
                cliPath = '/usr/bin/aws'
            }
        }
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Execution reports
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_${params.trace_timestamp}.html"
}

report {
    enabled = true
    file    = "${params.tracedir}/execution_report_${params.trace_timestamp}.html"
}

trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${params.trace_timestamp}.txt"
}

dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag_${params.trace_timestamp}.svg"
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pipeline manifest
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'drugMR'
    contributors    = [
        [name: 'Guillermo Comesaña Cimadevila', contribution: ['author', 'contributor', 'maintainer']],
        [name: 'Marie-Joe Dib', contribution: ['author']],
        [name: 'Matthew Bracher-Smith', contribution: ['author']],
        [name: 'Fiona Ducotterd', contribution: ['author']],
        [name: 'Dervis A. Salih', contribution: ['author']],
        [name: 'Nicholas J. Bray', contribution: ['author']],
        [name: 'Emily Simmonds', contribution: ['author']],
        [name: 'Valentina Escott-Price', contribution: ['author']],
    ]
    homePage        = 'https://github.com/guillermocomesanacimadevila/drugMR'
    description     = 'drugMR: a multi-omics pipeline for genetically anchored drug-target discovery'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.0'
    version         = '1.0.0'
}