/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    drugMR Nextflow demo config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Laptop-sized resources for the synthetic demo dataset. Inputs, the QTL
    manifest and the runs folder are set in conf/demo_params.yaml, passed with
    -params-file, so they are already known when nextflow.config builds the
    run id.
----------------------------------------------------------------------------------------
*/

process {

    // always == local
    executor = 'local'

    cpus = 2
    memory = 4.GB
    time = 30.m

    errorStrategy = 'terminate'
    maxRetries = 0

    withLabel: process_single {
        cpus   = 1
        memory = 2.GB
        time   = 15.m
    }

    withLabel: process_low {
        cpus   = 1
        memory = 2.GB
        time   = 15.m
    }

    withLabel: process_medium {
        cpus   = 2
        memory = 4.GB
        time   = 30.m
    }

    withLabel: process_smr {
        cpus   = 2
        memory = 4.GB
        time   = 30.m
    }

    withLabel: process_massive {
        cpus   = 4
        memory = 6.GB
        time   = 30.m
    }

    withLabel: process_long {
        cpus   = 2
        memory = 4.GB
        time   = 30.m
    }
}