/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    drugMR Nextflow test config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource limits and output locations for the synthetic end-to-end test suite.
    The executor and container engine are selected by the `test` profile in
    nextflow.config.
----------------------------------------------------------------------------------------
*/

params {
    runs_root = 'tests/output/runs'
    manifest_path = 'tests/data/qtl_manifest.csv'
}

process {

    executor = 'local'

    cpus   = 1
    memory = 2.GB
    time   = 10.m

    errorStrategy = 'terminate'
    maxRetries    = 0

    withLabel: process_single {
        cpus   = 1
        memory = 2.GB
        time   = 5.m
    }

    withLabel: process_low {
        cpus   = 1
        memory = 2.GB
        time   = 5.m
    }

    withLabel: process_medium {
        cpus   = 2
        memory = 4.GB
        time   = 10.m
    }

    withLabel: process_smr {
        cpus   = 2
        memory = 4.GB
        time   = 15.m
    }

    withLabel: process_massive {
        cpus   = 2
        memory = 4.GB
        time   = 15.m
    }

    withLabel: process_long {
        cpus   = 2
        memory = 4.GB
        time   = 15.m
    }
}
